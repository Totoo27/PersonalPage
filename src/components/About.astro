---
import Section from './Section.astro';
import { about } from '../data/site';
---
<Section id="sobre-mi" title="Sobre mí">
  <div class="grid">
    <div class="text">{about.paragraphs.map((p) => <p>{p}</p>)}</div>
    <dl>
      {about.facts.map((f) => (
        <div><dt>{f.label}</dt><dd>{f.value}</dd></div>
      ))}
    </dl>
  </div>
</Section>
<style>
  .grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(1.5rem, 5vw, 4rem); }
  .text { display: grid; gap: 1rem; color: var(--muted); font-size: 1.05rem; }
  dl { margin: 0; display: grid; gap: .9rem; align-content: start; padding: 1.25rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); }
  dt { font-family: var(--mono); font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; color: var(--accent); }
  dd { margin: .1rem 0 0; }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr; } }
</style>
