---
interface Props { id: string; title: string }
const { id, title } = Astro.props;
---
<section id={id} aria-labelledby={`${id}-t`} class="section">
  <div class="wrap reveal">
    <h2 id={`${id}-t`} class="section-heading eyebrow">{title}</h2>
    <slot />
  </div>
</section>
<style>
  .section { padding-block: clamp(3.5rem, 8vw, 6rem); }
  .section-heading { font-size: clamp(1.7rem, 4vw, 2.4rem); line-height: 1.2; margin: 0 0 2rem; letter-spacing: -.01em; }
</style>
