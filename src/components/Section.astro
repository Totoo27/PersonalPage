---
interface Props { id: string; eyebrow: string; title: string }
const { id, eyebrow, title } = Astro.props;
---
<section id={id} aria-labelledby={`${id}-t`} class="section">
  <div class="wrap reveal">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id={`${id}-t`}>{title}</h2>
    <slot />
  </div>
</section>
<style>
  .section { padding-block: clamp(3.5rem, 8vw, 6rem); }
  h2 { font-size: clamp(1.7rem, 4vw, 2.4rem); line-height: 1.2; margin: .4rem 0 2rem; letter-spacing: -.01em; }
</style>
